# Copy to `.env` and adjust.

# Base URL for every API call (`apiUrl()` in src/shared/config/api.ts).
# MUST end with `/api` (ASP.NET global prefix).
#
# Option A — relative + Vite proxy to http://localhost:5151 (http launch profile):
VITE_BASE_API_URL=/api

# Option B — direct (enable CORS on API if origin differs):
# VITE_BASE_API_URL=http://localhost:5151/api
# VITE_BASE_API_URL=https://localhost:7256/api

VITE_DEV_SERVER_PORT=5173

VITE_APP_NAME=Billing Application
